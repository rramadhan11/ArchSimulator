{
  "version": "0.1",
  "catalogVersion": "2026.10",
  "nodes": [
    { "id": "users", "kind": "client.web" },
    { "id": "lb", "kind": "lb.alb" },
    { "id": "pool", "kind": "k8s.nodepool", "config": { "instanceType": "c6i.xlarge", "min": 2, "max": 8, "clusterAutoscaler": true } },
    { "id": "api-deploy", "kind": "k8s.deployment", "parent": "pool",
      "config": { "requests": { "cpu": "500m", "memory": "512Mi" }, "limits": { "cpu": "1" },
                  "hpa": { "min": 2, "max": 20, "targetCPU": 70 } } },
    { "id": "api", "kind": "service.go", "parent": "api-deploy", "config": { "cpuMsPerReq": 4 } },
    { "id": "redis", "kind": "cache.redis", "config": { "hitRatio": 0.9 } },
    { "id": "pg", "kind": "db.postgres", "config": { "instanceType": "db.r6g.xlarge", "maxConnections": 400 } }
  ],
  "edges": [
    { "from": "users", "to": "lb" },
    { "from": "lb", "to": "api", "timeoutMs": 5000 },
    { "from": "api", "to": "redis" },
    { "from": "api", "to": "pg", "op": "read", "when": "cache_miss:redis" }
  ],
  "workload": {
    "entry": "users",
    "targetTps": 300,
    "slo": { "p99Ms": 250, "errorRate": 0.001 },
    "timeline": {
      "durationS": 600,
      "load": { "kind": "spike", "peakTps": 1500, "startS": 60, "rampS": 30, "holdS": 240 }
    }
  }
}
