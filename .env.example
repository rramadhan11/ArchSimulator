# ArchSim server config (single-user login). Copy to .env and fill in; never commit .env.
ARCHSIM_USERNAME=rizky
# bcrypt hash, generate with: go run ./apps/api hash-password
ARCHSIM_PASSWORD_HASH=
# >= 32 chars, e.g.: openssl rand -hex 32  (rotating it signs everyone out)
ARCHSIM_SESSION_SECRET=
ARCHSIM_ADDR=:8080
ARCHSIM_WEB_DIR=apps/web/dist
ARCHSIM_SESSION_TTL=168h
# false only for local http://localhost development
ARCHSIM_COOKIE_SECURE=true
# true when behind Caddy/Nginx so login rate-limiting sees the real client IP
ARCHSIM_TRUST_PROXY=false
